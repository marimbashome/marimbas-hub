{
  "rewrites": [
    {
      "source": "/blog/:path*",
      "destination": "https://book.marimbashome.com/es/guides/:path*"
    }
  ],
  "headers": [
    {
      "source": "/blog/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "all"
        }
      ]
    }
  ]
}
