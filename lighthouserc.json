{
  "_comment": "Marimbas cross-cutting rollout 2026-05. Thresholds intentionally lenient for first run; raise after baseline.",
  "ci": {
    "collect": {
      "url": ["${LHCI_TARGET_URL}"],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "skipAudits": ["uses-http2"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance":   ["warn", { "minScore": 0.70 }],
        "categories:accessibility": ["warn", { "minScore": 0.85 }],
        "categories:best-practices":["warn", { "minScore": 0.85 }],
        "categories:seo":           ["warn", { "minScore": 0.85 }],
        "color-contrast":           "warn",
        "image-alt":                "warn",
        "viewport":                 "warn",
        "html-has-lang":            "warn",
        "meta-description":         "warn"
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
